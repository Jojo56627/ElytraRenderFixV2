{
	"schemaVersion": 1,
	"id": "elytra-render-fix",
	"version": "${version}",
	"name": "ElytraRenderFix",
	"description": "This mod fixes a bug in Minecraft's code that causes elytras to have a missingno texture when an item renders a trimmed armor piece AND an elytra via resource pack and minecraft:equippable component.",
	"authors": [
		"Quarxy"
	],
	"contact": {},
	"license": "All-Rights-Reserved",
	"icon": "assets/elytra-render-fix/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"net.quarxy.ElytraRenderFixMod"
		],
		"client": [
			"net.quarxy.ElytraRenderFixClient"
		]
	},
	"mixins": [
		{
			"config": "elytra-render-fix.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": "*"
	}
}